# Created interactively by install.sh. Never commit a real .env.
DOMAIN=minipacs.example.com
DICOM_AE_TITLE=MINIPACS
ALLOWED_CALLING_AE=MODALITY
DICOM_PORT=11112
DICOM_BIND_ADDRESS=0.0.0.0
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace_with_argon2_hash
SESSION_SECRET=replace_with_random_secret
RETENTION_DAYS=15
COOKIE_SECURE=true
MAX_BULK_STUDIES=20
MAX_BULK_BYTES=21474836480
MAX_DICOM_FILE_BYTES=536870912
# Leave the external API disabled until a token hash and explicit frontend origin are configured.
EXTERNAL_API_TOKEN_HASH=
EXTERNAL_API_TOKEN_NAME=lovable-backend
EXTERNAL_API_ALLOWED_ORIGINS=https://app.example.com
EXTERNAL_API_RATE_LIMIT_PER_MINUTE=60
